# Path to the repository you want to index (can be overridden with --path)
PROJECT_ROOT=.

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Files larger than this are skipped
MAX_FILE_SIZE_MB=2

# Lists can be overridden as JSON arrays, e.g.:
# SUPPORTED_EXTENSIONS=[".md", ".py"]
# EXCLUDED_DIRS=[".git", "node_modules"]

# ---- Embeddings & vector search ----
# Embedding backend: sentence_transformers (local model) or fake (tests only)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Where Chroma stores its data (gitignored)
CHROMA_PERSIST_DIR=./chroma_db
# Collections are named <prefix>_<folder_name>_<8-char hash of the absolute path>
CHROMA_COLLECTION_PREFIX=project

# Default number of results and minimum similarity (0..1)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

# ---- LLM (RAG question answering) ----
# Provider: anthropic | openai_compatible | fake (tests only)
LLM_PROVIDER=anthropic
# Required unless LLM_PROVIDER=fake (e.g. a Claude model ID, an OpenAI model, or an Ollama model name)
LLM_MODEL=
# Only for openai_compatible servers other than OpenAI, e.g.
#   Ollama:     http://localhost:11434/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# API keys: set only the one you use. Never commit a real key.
ANTHROPIC_API_KEY=
# Also used for Groq/OpenRouter keys with openai_compatible; not needed for local Ollama
OPENAI_API_KEY=

LLM_MAX_OUTPUT_TOKENS=1024
# Set to "none" to omit temperature (required by some reasoning models; always omitted for Anthropic)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Max characters of retrieved sources sent to the LLM
RAG_MAX_CONTEXT_CHARS=12000

# ---- MCP server ----
# Comma-separated ABSOLUTE paths. MCP tools only work on projects inside these roots.
# Empty = the MCP server refuses to start.
MCP_ALLOWED_PROJECT_ROOTS=
MCP_MAX_FILE_CHARS=20000
MCP_MAX_TOP_K=10

# ---- GitHub (read-only) ----
# Optional fine-grained token with read-only access (see docs/github.md). Never commit it.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Default repository for GitHub commands/tools, as owner/name
GITHUB_DEFAULT_REPO=
# Comma-separated owner/name allowlist. Empty = only GITHUB_DEFAULT_REPO is allowed.
GITHUB_ALLOWED_REPOS=
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_RESULTS=20
GITHUB_MAX_PAGES=3
GITHUB_MAX_BODY_CHARS=4000
GITHUB_MAX_COMMENTS=10
