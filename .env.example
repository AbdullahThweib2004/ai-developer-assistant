# Path to the repository you want to index (can be overridden with --path)
PROJECT_ROOT=.

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Files larger than this are skipped
MAX_FILE_SIZE_MB=2

# Lists can be overridden as JSON arrays, e.g.:
# SUPPORTED_EXTENSIONS=[".md", ".py"]
# EXCLUDED_DIRS=[".git", "node_modules"]

# ---- Embeddings & vector search ----
# Embedding backend: sentence_transformers (local model) or fake (tests only)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Where Chroma stores its data (gitignored)
CHROMA_PERSIST_DIR=./chroma_db
# Collections are named <prefix>_<folder_name>_<8-char hash of the absolute path>
CHROMA_COLLECTION_PREFIX=project

# Default number of results and minimum similarity (0..1)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
